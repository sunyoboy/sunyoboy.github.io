# 微信公众号开发者配置
# 登录 mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_APPID=wx_your_appid_here
WECHAT_APPSECRET=your_appsecret_here
WECHAT_AUTHOR=知行合一

# 一键复盘生成器 · AI 分析（scripts/generate-review.py）
# 留空则自动降级为「数据填充草稿 + 提示词」模式，可交给 TraeCN/Claude 完成
# 任意 OpenAI 兼容接口均可（DeepSeek / 通义 / 智谱 / OpenAI …）
REVIEW_LLM_API_KEY=
REVIEW_LLM_BASE_URL=https://api.deepseek.com
REVIEW_LLM_MODEL=deepseek-flash
